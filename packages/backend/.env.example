# Backend Environment
# Copy to .env and fill in values

# === Server ===
PORT=3001
CORS_ORIGIN=http://localhost:5173

# === Solana ===
# Solana RPC (devnet)
SOLANA_RPC_URL=https://api.devnet.solana.com

# Risk authority keypair (base58 encoded secret key)
# Generate with: solana-keygen new --outfile risk-authority.json
# Then encode: node -e "console.log(require('bs58').default.encode(require('fs').readFileSync('risk-authority.json')))"
RISK_AUTHORITY_SECRET_KEY=

# Program ID (update after anchor build)
SOLANA_PROGRAM_ID=9Z6HNGC1wz6ukVCD3qNQnfFMFfNCfNPB6dG5k8fakHc

# Listener poll interval for pending spend requests (ms)
RISK_POLL_INTERVAL_MS=12000

# === AI provider ===
AI_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash
AI_TIMEOUT_MS=30000

# === Firebase ===
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_CLIENT_EMAIL=your_firebase_client_email
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
FIREBASE_REQUIRE_VERIFIED_AUTH=false

# === Database ===
# SQLite file path. Defaults to <cwd>/data/aegis.db
DB_PATH=data/aegis.db
